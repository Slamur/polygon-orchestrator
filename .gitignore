.env
__pycache__/
*.pyc

.venv/
venv/

problems/*
!problems/.gitkeep

# problem drafts for `init --draft` — the same problem essence as in the spec
drafts/*
!drafts/.gitkeep

# the orchestrator's service files in the sample problems (the samples themselves are committed):
# step cache, model logs and reports, the Polygon binding (the author's personal problemId), backups of pull,
# llm generate and local fix, files a step proposed to delete.
# limits.yaml is committed: the actual TL/ML are part of the problem, after tuning on
# Polygon they differ from constraints.yaml
examples/**/.cache/
examples/**/.pull_backup/
examples/**/.llm_backup/
examples/**/.llm_conflicts/
examples/**/.fix_backup/
examples/**/.tests_cache/
examples/**/*.removed
examples/**/polygon_state.json
examples/**/llm_generation.log
examples/**/llm_reports/
examples/**/polygon.log

# the former name of the problems directory (now problems/) — in case local copies remain
outputs/

# the former location of specs (now problems/<problem_id>/spec.yaml) — in case local copies remain
specs/

*.egg-info
