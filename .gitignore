.env
__pycache__/
*.pyc

.venv/
venv/

problems/*
!problems/.gitkeep

# черновики задач для `init --draft` — та же суть задачи, что и в спеке
drafts/*
!drafts/.gitkeep

# служебные файлы оркестратора в учебных задачах (сами образцы коммитятся):
# кэш шагов, логи, привязка к Polygon (личный problemId автора), бэкапы pull,
# llm generate и polygon fix, файлы, которые шаг предложил удалить.
# limits.yaml коммитится: актуальные TL/ML — часть задачи, после подгонки на
# Polygon они отличаются от constraints.yaml
examples/**/.cache/
examples/**/.pull_backup/
examples/**/.llm_backup/
examples/**/.llm_conflicts/
examples/**/.fix_backup/
examples/**/*.removed
examples/**/polygon_state.json
examples/**/llm_generation.log
examples/**/polygon.log

# прежнее имя каталога задач (теперь problems/) — на случай оставшихся локальных копий
outputs/

# прежнее место спеков (теперь problems/<problem_id>/spec.yaml) — на случай оставшихся локальных копий
specs/

*.egg-info
