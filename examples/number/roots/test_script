<#assign desc = "Generators"/>
<#assign randGen = "gen_n_rand"/>
<#assign powerGen = "gen_n_power"/>
<#assign baseGen = "gen_n_pow_of_base"/>

<#assign desc = "Functions"/>
<#function div a b>
    <#return (a / b)?long>
</#function>
<#function ceil a b>
    <#return div(a - 1, b) + 1/>
</#function>
<#function min a b>
    <#return [a, b]?sort?first>
</#function>
<#function max a b>
    <#return [a, b]?sort?last>
</#function>
<#function pow base power>
    <#assign res = 1/>
    <#list 0..<power as it>
        <#assign res = res * base/>
    </#list>
    <#return res>
</#function>
<#function fact n>
    <#assign res = 1/>
    <#list 0..<n as it>
        <#assign res = res * (it + 1)/>
    </#list>
    <#return res>
</#function>
<#function contains items value>
    <#list items as item>
        <#if item == value>
            <#return true/>
        </#if>
    </#list>
    <#return false/>
</#function>

<#assign desc = "Constraints"/>
<#assign minN = 1/>
<#assign maxNExp = 18/>
<#assign maxN = pow(10, maxNExp)/>

<#assign desc = "Script functions"/>
<#-- the largest p for which base^p <= limit -->
<#function max_exp base limit>
    <#list 1..64 as p>
        <#if pow(base, p) gt limit>
            <#return p - 1/>
        </#if>
    </#list>
</#function>

<#assign desc = "Generation"/>
<#assign deltas = [-1, 0, 1]/>

<#assign desc = "Small tests"/>
<#assign tinyMaxN = 20/>
<#list minN..tinyMaxN as n>
    ${randGen} -minN=${n} -maxN=${n} > $
</#list>

<#assign smallMaxN = 1000/>
${randGen} -minN=${minN} -maxN=${smallMaxN} > $
${randGen} -minN=${smallMaxN} -maxN=${smallMaxN * smallMaxN} > $

<#assign desc = "Edge cases: powers of 2 and 10"/>
<#-- b^p + a random delta from -1..1 (chosen by the generator); the powers are chosen so
     that all N > tinyMaxN and N < maxN - 1 (N = maxN - 1 and maxN = 10^18 are in the maximal tests below):
     2^6 = 4^3 = 8^2, 2^30 = 1024^3 = 32768^2, 2^31 / 2^32 - the int / unsigned int bounds,
     2^48 = 65536^3, 2^53 / 2^54 - the double precision bound, 2^59 - the largest power of 2 <= 10^18;
     10^6, 10^12 - a square and a cube, 10^9, 10^15 - a cube, 10^16 - a square above 2^53, 10^17 - neither -->
<#list [6, 10, 20, 30, 31, 32, 48, 53, 54, 59] as p>
    ${baseGen} -b=2 -p=${p} > $
</#list>
<#list [2, 3, 6, 9, 12, 15, 16, 17] as p>
    ${baseGen} -b=10 -p=${p} > $
</#list>

<#assign desc = "Edge cases: random B^k + delta"/>
<#-- B is random up to the largest allowed; with delta = -1 B >= 2, otherwise N = 0 -->
<#list [2, 3, 4, 5, 6, 12] as k>
    <#list deltas as delta>
        ${powerGen} -k=${k} -maxN=${maxN} -minB=${max(1, 1 - delta)} -delta=${delta} > $
    </#list>
</#list>

<#assign desc = "Edge cases: B^k + delta for the largest B"/>
<#-- maxN = 10^maxNExp is the exact k-th power of topB = 10^(maxNExp / k) for k = 2, 3, 6
     (10^9, 10^6, 10^3); topB^k + delta (N = maxN - 1 and maxN) are in the maximal tests below,
     here B = topB - 1: the largest B for which any delta from -1..1 is allowed (chosen by the generator) -->
<#list [2, 3, 6] as k>
    <#assign topB = pow(10, div(maxNExp, k))/>
    ${baseGen} -b=${topB - 1} -p=${k} > $
</#list>

<#assign desc = "Maximal tests"/>
<#-- N = 10^18 (both 10^6 cubed and 10^9 squared) and N = 10^18 - 1 -->
${randGen} -minN=${maxN} -maxN=${maxN} > $
${randGen} -minN=${maxN - 1} -maxN=${maxN - 1} > $

<#assign desc = "Specific: random N across the whole range"/>
${randGen} -minN=${minN} -maxN=${maxN} > $
${randGen} -minN=${div(maxN, 2)} -maxN=${maxN} > $
${randGen} -minN=${minN} -maxN=${div(maxN, 2)} > $
