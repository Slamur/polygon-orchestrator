#!/usr/bin/env bash
# Блокирует push, если имя ветки или сообщения коммитов (относительно
# origin/main) содержат problem_id любой задачи в problems/ — имя каталога
# задачи на любой глубине (каталог с authoring/spec.yaml, spec.yaml — до
# переноса в authoring/ — или polygon_state.json, см.
# orchestrator/problem_paths.py; группирующие каталоги вроде года или раунда не
# проверяются — иначе короткие имена давали бы ложные срабатывания), — и имя
# любого каталога в outputs/ (прежнее имя каталога задач, на случай оставшейся
# локальной копии), и имя (без расширения) любого черновика в drafts/
# (`init --draft`), кроме черновиков учебных задач из examples/ — они
# публичны. См. "Конфиденциальность problems/" в CLAUDE.md.
#
# Подключение (один раз после клонирования): git config core.hooksPath githooks

set -u
# Сравнение problem_id с веткой/сообщениями — без учёта регистра.
shopt -s nocasematch

repo_root="$(git rev-parse --show-toplevel)" || exit 0

# Каталог задачи по найденному маркеру: спек в authoring/ — на уровень выше.
marker_problem_dir() {
    local dir
    dir="$(dirname "$1")"
    [ "$(basename "$dir")" = authoring ] && dir="$(dirname "$dir")"
    printf '%s\n' "$dir"
}

problem_ids=()
if [ -d "$repo_root/problems" ]; then
    while IFS= read -r -d '' marker; do
        problem_id="$(basename "$(marker_problem_dir "$marker")")"
        # spec.yaml и polygon_state.json одной задачи — один problem_id
        [[ " ${problem_ids[*]} " == *" $problem_id "* ]] || problem_ids+=("$problem_id")
    done < <(find "$repo_root/problems" -mindepth 1 -name '.*' -prune -o \
        -type f \( -name spec.yaml -o -name polygon_state.json \) -print0)
fi
shopt -s nullglob
for legacy_dir in "$repo_root"/outputs/*/; do
    problem_ids+=("$(basename "$legacy_dir")")
done
shopt -u nullglob

# Черновики учебных задач из examples/ (публичных) не проверяются: черновик
# с именем задачи examples/ — её имя каталога или problem_id (путь через "--").
example_names=" "
if [ -d "$repo_root/examples" ]; then
    while IFS= read -r -d '' marker; do
        example_dir="$(marker_problem_dir "$marker")"
        example_rel="${example_dir#"$repo_root/examples/"}"
        example_names+="$(basename "$example_dir") ${example_rel//\//--} "
    done < <(find "$repo_root/examples" -mindepth 1 -name '.*' -prune -o \
        -type f \( -name spec.yaml -o -name polygon_state.json \) -print0)
fi

shopt -s nullglob
for draft in "$repo_root"/drafts/*; do
    [ -f "$draft" ] || continue
    draft_name="$(basename "$draft")"
    draft_name="${draft_name%.*}"
    [[ "$example_names" == *" $draft_name "* ]] && continue
    problem_ids+=("$draft_name")
done
shopt -u nullglob

if [ ${#problem_ids[@]} -eq 0 ]; then
    exit 0
fi

branch="$(git rev-parse --abbrev-ref HEAD)"

# Коммиты, которых ещё нет в origin/main; если origin/main недоступен
# (например, самый первый push) — сравниваем против пустого списка.
commits=""
if git rev-parse --verify --quiet origin/main >/dev/null; then
    commits="$(git rev-list origin/main..HEAD)"
fi

leaked=0
for problem_id in "${problem_ids[@]}"; do
    [ -n "$problem_id" ] || continue

    if [[ "$branch" == *"$problem_id"* ]]; then
        echo "pre-push: problem_id '$problem_id' found in branch name '$branch'" >&2
        leaked=1
    fi

    for sha in $commits; do
        message="$(git log -1 --format=%B "$sha")"
        if [[ "$message" == *"$problem_id"* ]]; then
            echo "pre-push: problem_id '$problem_id' found in commit message $(git rev-parse --short "$sha")" >&2
            leaked=1
        fi
    done
done

if [ "$leaked" -ne 0 ]; then
    echo "pre-push: push blocked — rename the branch / rewrite the commit messages." >&2
    exit 1
fi

exit 0
