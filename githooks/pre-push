#!/usr/bin/env bash
# Blocks the push if the branch name or the commit messages (relative to
# origin/main) contain the problem_id of any problem in problems/ — the name of a problem
# directory at any depth (a directory with authoring/spec.yaml, spec.yaml — before
# the move to authoring/ — or polygon_state.json, see
# orchestrator/problem_paths.py; grouping directories like a year or a round aren't
# checked — otherwise short names would give false positives), — and the name of
# any directory in outputs/ (the former name of the problems directory, in case a local
# copy remains), and the name (without extension) of any draft in drafts/ at any
# depth (`init --draft`; subdirectory names aren't checked — like the grouping
# directories of problems/), except drafts of the sample problems from examples/ — they are
# public. See "Confidentiality of problems/" in CLAUDE.md.
#
# Enabling (once after cloning): git config core.hooksPath githooks

set -u
# Comparing problem_id with the branch/messages is case-insensitive.
shopt -s nocasematch

repo_root="$(git rev-parse --show-toplevel)" || exit 0

# The problem directory of a found marker: for a spec in authoring/ — one level up.
marker_problem_dir() {
    local dir
    dir="$(dirname "$1")"
    [ "$(basename "$dir")" = authoring ] && dir="$(dirname "$dir")"
    printf '%s\n' "$dir"
}

problem_ids=()
if [ -d "$repo_root/problems" ]; then
    while IFS= read -r -d '' marker; do
        problem_id="$(basename "$(marker_problem_dir "$marker")")"
        # spec.yaml and polygon_state.json of one problem are one problem_id
        [[ " ${problem_ids[*]} " == *" $problem_id "* ]] || problem_ids+=("$problem_id")
    done < <(find "$repo_root/problems" -mindepth 1 -name '.*' -prune -o \
        -type f \( -name spec.yaml -o -name polygon_state.json \) -print0)
fi
shopt -s nullglob
for legacy_dir in "$repo_root"/outputs/*/; do
    problem_ids+=("$(basename "$legacy_dir")")
done
shopt -u nullglob

# Drafts of the sample problems from examples/ (public) aren't checked: a draft
# named after an examples/ problem — its directory name or problem_id (the path joined with "--").
example_names=" "
if [ -d "$repo_root/examples" ]; then
    while IFS= read -r -d '' marker; do
        example_dir="$(marker_problem_dir "$marker")"
        example_rel="${example_dir#"$repo_root/examples/"}"
        example_names+="$(basename "$example_dir") ${example_rel//\//--} "
    done < <(find "$repo_root/examples" -mindepth 1 -name '.*' -prune -o \
        -type f \( -name spec.yaml -o -name polygon_state.json \) -print0)
fi

if [ -d "$repo_root/drafts" ]; then
    while IFS= read -r -d '' draft; do
        draft_name="$(basename "$draft")"
        draft_name="${draft_name%.*}"
        [[ "$example_names" == *" $draft_name "* ]] && continue
        problem_ids+=("$draft_name")
    done < <(find "$repo_root/drafts" -mindepth 1 -name '.*' -prune -o -type f -print0)
fi

if [ ${#problem_ids[@]} -eq 0 ]; then
    exit 0
fi

branch="$(git rev-parse --abbrev-ref HEAD)"

# Commits not yet in origin/main; if origin/main is unavailable
# (e.g. the very first push) — compare against an empty list.
commits=""
if git rev-parse --verify --quiet origin/main >/dev/null; then
    commits="$(git rev-list origin/main..HEAD)"
fi

leaked=0
for problem_id in "${problem_ids[@]}"; do
    [ -n "$problem_id" ] || continue

    if [[ "$branch" == *"$problem_id"* ]]; then
        echo "pre-push: problem_id '$problem_id' found in branch name '$branch'" >&2
        leaked=1
    fi

    for sha in $commits; do
        message="$(git log -1 --format=%B "$sha")"
        if [[ "$message" == *"$problem_id"* ]]; then
            echo "pre-push: problem_id '$problem_id' found in commit message $(git rev-parse --short "$sha")" >&2
            leaked=1
        fi
    done
done

if [ "$leaked" -ne 0 ]; then
    echo "pre-push: push blocked — rename the branch / rewrite the commit messages." >&2
    exit 1
fi

exit 0
