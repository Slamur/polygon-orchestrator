<#assign desc = "Generators"/>
<#assign randGen = "gen_n_rand"/>
<#assign powerGen = "gen_n_power"/>
<#assign baseGen = "gen_n_pow_of_base"/>

<#assign desc = "Functions"/>
<#function div a b>
    <#return (a / b)?long>
</#function>
<#function ceil a b>
    <#return div(a - 1, b) + 1/>
</#function>
<#function min a b>
    <#return [a, b]?sort?first>
</#function>
<#function max a b>
    <#return [a, b]?sort?last>
</#function>
<#function pow base power>
    <#assign res = 1/>
    <#list 0..<power as it>
        <#assign res = res * base/>
    </#list>
    <#return res>
</#function>
<#function fact n>
    <#assign res = 1/>
    <#list 0..<n as it>
        <#assign res = res * (it + 1)/>
    </#list>
    <#return res>
</#function>
<#function contains items value>
    <#list items as item>
        <#if item == value>
            <#return true/>
        </#if>
    </#list>
    <#return false/>
</#function>

<#assign desc = "Constraints"/>
<#assign minN = 1/>
<#assign maxNExp = 18/>
<#assign maxN = pow(10, maxNExp)/>

<#assign desc = "Script functions"/>
<#-- наибольшее p, для которого base^p <= limit -->
<#function max_exp base limit>
    <#list 1..64 as p>
        <#if pow(base, p) gt limit>
            <#return p - 1/>
        </#if>
    </#list>
</#function>

<#assign desc = "Generation"/>
<#assign deltas = [-1, 0, 1]/>

<#assign desc = "Small tests"/>
<#assign tinyMaxN = 30/>
<#list minN..tinyMaxN as n>
    ${randGen} -minN=${n} -maxN=${n} > $
</#list>

<#assign smallMaxN = 1000/>
${randGen} -minN=${minN} -maxN=${smallMaxN} > $
${randGen} -minN=${smallMaxN} -maxN=${smallMaxN * smallMaxN} > $

<#assign desc = "Edge cases: powers of 2 and 10"/>
<#-- b^p + delta; N <= tinyMaxN уже есть среди мелких тестов,
     N = maxN - 1 и maxN = 10^18 — в максимальных тестах ниже -->
<#list [2, 10] as b>
    <#list 1..max_exp(b, maxN) as p>
        <#list deltas as delta>
            <#assign n = pow(b, p) + delta/>
            <#if n gt tinyMaxN && n lt maxN - 1>
                ${baseGen} -b=${b} -p=${p} -delta=${delta} > $
            </#if>
        </#list>
    </#list>
</#list>

<#assign desc = "Edge cases: random B^k + delta"/>
<#-- B случайно до наибольшего допустимого; при delta = -1 B >= 2, иначе N = 0 -->
<#list [2, 3, 4, 5, 6, 12] as k>
    <#list deltas as delta>
        ${powerGen} -k=${k} -maxN=${maxN} -minB=${max(1, 1 - delta)} -delta=${delta} > $
    </#list>
</#list>

<#assign desc = "Edge cases: B^k + delta for the largest B"/>
<#-- maxN = 10^maxNExp — точная k-я степень topB = 10^(maxNExp / k) для k = 2, 3, 6
     (10^9, 10^6, 10^3); topB^k + delta (N = maxN - 1 и maxN) — в максимальных тестах ниже,
     здесь B = topB - 1: наибольшее B, для которого допустимы все delta -->
<#list [2, 3, 6] as k>
    <#assign topB = pow(10, div(maxNExp, k))/>
    <#list deltas as delta>
        ${baseGen} -b=${topB - 1} -p=${k} -delta=${delta} > $
    </#list>
</#list>

<#assign desc = "Maximal tests"/>
<#-- N = 10^18 (одновременно 10^6 в кубе и 10^9 в квадрате) и N = 10^18 - 1 -->
${randGen} -minN=${maxN} -maxN=${maxN} > $
${randGen} -minN=${maxN - 1} -maxN=${maxN - 1} > $

<#assign desc = "Specific: random N across the whole range"/>
${randGen} -minN=${minN} -maxN=${maxN} > $
${randGen} -minN=${div(maxN, 2)} -maxN=${maxN} > $
${randGen} -minN=${minN} -maxN=${div(maxN, 2)} > $
