<#assign desc = "Generators"/>
<#assign array_rand = "gen_array_rand"/>
<#assign array_distinct = "gen_array_distinct"/>
<#assign k_rand = "gen_k_rand"/>
<#assign k_large = "gen_k_too_large"/>
<#assign k_pref = "gen_k_eq_pref"/>
<#assign upd_sort = "upd_array_sort"/>

<#assign desc = "Functions"/>
<#function div a b>
    <#return (a / b)?long>
</#function>
<#function ceil a b>
    <#return div(a - 1, b) + 1/>
</#function>
<#function min a b>
    <#return [a, b]?sort?first>
</#function>
<#function max a b>
    <#return [a, b]?sort?last>
</#function>
<#function pow base power>
    <#assign res = 1/>
    <#list 0..<power as it>
        <#assign res = res * base/>
    </#list>
    <#return res>
</#function>
<#function fact n>
    <#assign res = 1/>
    <#list 0..<n as it>
        <#assign res = res * (it + 1)/>
    </#list>
    <#return res>
</#function>
<#function contains items value>
    <#list items as item>
        <#if item == value>
            <#return true/>
        </#if>
    </#list>
    <#return false/>
</#function>

<#assign desc = "Constraints"/>
<#assign minN = 1/>
<#assing maxN = 2 * pow(10, 5)/>
<#assign minK = 0/>
<#assign maxK = 1 * pow(10, 15)/>
<#assign minA = 0/>
<#assign maxA = 1 * pow(10, 9)/>

<#assign desc = "Generation"/>
<#assign smallN = 10/>
<#assign smallA = pow(10, 2)/>

<#list minN..smallN as n>
    <#assign smallK = n * smallA/>

    ${array_rand} -n=${n} -minA=${minA} -maxA=${smallA} | ${k_rand} -minK=${minK} -maxK=${smallK} > $
</#list>

<#list minN..smallN as n>
    ${array_rand} -n=${n} -minA=${minA} -maxA=${maxA} | ${k_rand} -minK=${minK} -maxK=${maxK} > $
</#list>

${array_distinct} -n=${maxN} -minA=${minA} -maxA=${maxA} | ${k_rand} -minK=${minK} -maxK=${maxK} > $
${array_distinct} -n=${maxN} -minA=${minA} -maxA=${maxA} | ${k_rand} -minK=${minK} -maxK=${maxK} | ${upd_sort} > $
${array_distinct} -n=${maxN} -minA=${minA} -maxA=${maxA} | ${k_rand} -minK=${minK} -maxK=${maxK} | ${upd_sort} --desc > $

<#list [minA, maxA] as startA>
    <#list [minK, maxK] as startK>
        ${array_rand} -n=${maxN} -minA=${startA} -maxA=${maxA} | ${k_rand} -minK=${startK} -maxK=${maxK} > $
    </#list>

    ${array_rand} -n=${maxN} -minA=${startA} -maxA=${maxA} | ${k_large} -maxK=${maxK} > $

    <#list -1..1 as delta>
        ${array_rand} -n=${maxN} -minA=${startA} -maxA=${maxA} | ${k_pref} -delta=${delta} > $
    </#list>
</#list>


