# Backend of the generative steps: claude-code (default, the Claude Code CLI on
# the subscription, see docs/SETUP.md) or anthropic-api (with ANTHROPIC_API_KEY).
ORCHESTRATOR_LLM_BACKEND=claude-code
# Only for anthropic-api.
ANTHROPIC_API_KEY=
# Only for claude-code: the path to the binary, if not `claude` from PATH.
CLAUDE_CODE_BIN=
# Only for claude-code: the limit of one model call in seconds (1800 by
# default).
ORCHESTRATOR_LLM_TIMEOUT=

# Polygon API: key/secret are taken in Polygon on the Settings → API keys tab.
POLYGON_API_KEY=
POLYGON_API_SECRET=
POLYGON_API_BASE_URL=https://polygon.codeforces.com/api
