# Бэкенд генеративных шагов: claude-code (по умолчанию, Claude Code CLI по
# подписке, см. docs/SETUP.md) или anthropic-api (по ANTHROPIC_API_KEY).
ORCHESTRATOR_LLM_BACKEND=claude-code
# Только для anthropic-api.
ANTHROPIC_API_KEY=
# Только для claude-code: путь к бинарю, если не `claude` из PATH.
CLAUDE_CODE_BIN=

# Polygon API: key/secret берутся в Polygon на вкладке Settings → API keys.
POLYGON_API_KEY=
POLYGON_API_SECRET=
POLYGON_API_BASE_URL=https://polygon.codeforces.com/api
