# Бэкенд генеративных шагов: anthropic-api (по умолчанию, по ANTHROPIC_API_KEY)
# или claude-code (Claude Code CLI по подписке, см. docs/SETUP.md).
ORCHESTRATOR_LLM_BACKEND=
ANTHROPIC_API_KEY=
# Только для claude-code: путь к бинарю, если не `claude` из PATH.
CLAUDE_CODE_BIN=

# Polygon API: key/secret берутся в Polygon на вкладке Settings → API keys.
POLYGON_API_KEY=
POLYGON_API_SECRET=
POLYGON_API_BASE_URL=https://polygon.codeforces.com/api
